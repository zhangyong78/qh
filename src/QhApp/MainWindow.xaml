                                    </StackPanel>
                                </Expander>
                                <TextBlock Text="仅运行可信本地策略；交易回放不接真实下单。" TextWrapping="Wrap" Foreground="#FF667085" Margin="0,8,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="连接">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,8,0">
                            <StackPanel>
                                <TextBlock Text="本地 CSV 回放无需连接。以下用于行情服务和后台进程。" TextWrapping="Wrap" Foreground="#FF667085" Margin="0,0,0,12" />
                                <GroupBox Header="账号与本机连接" Margin="0,0,0,12">
                                    <StackPanel Margin="6">
                                        <TextBlock Text="账号" TextWrapping="Wrap" />
