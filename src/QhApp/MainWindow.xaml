<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="QhApp.MainWindow" Title="期货研究与回测工作台" Width="1440" Height="900" MinWidth="980" MinHeight="620" Background="#FFF3F5F9" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="#FF1D2939" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="#FFD7DCE2" BorderThickness="0,0,0,1" Padding="16,12" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="期货研究与回测工作台" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="历史行情 · 策略回测 · 交易报告" Foreground="#FF667085" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="WorkflowStepText" Text="步骤 1/8：选择合约和周期　→　下一步：选择行情来源与日期区间" Foreground="#FF175CD3" Margin="0,6,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="本地数据" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="DataStatusText" Text="未导入" Foreground="#FFB54708" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
        <StatusBar DockPanel.Dock="Bottom" Background="White" Padding="12,4">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" TextWrapping="Wrap" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="WorkerStatusText" Text="Worker：未启动" TextWrapping="Wrap" />
            </StatusBarItem>
        </StatusBar>
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="340" MinWidth="300" MaxWidth="480" />
                <ColumnDefinition x:Name="SidebarGapColumn" Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="SidebarPanel" Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" CornerRadius="8">
                <TabControl x:Name="WorkflowTabs" BorderThickness="0">
                    <TabItem Header="数据">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,8,0">
                            <StackPanel>
                                <TextBlock Text="主路径：先选已有数据；没有时再下载。选好数据后到“策略”页回测。" TextWrapping="Wrap" Foreground="#FF667085" Margin="0,0,0,12" />
                                <GroupBox Header="01  选择已下载/已导入的数据" Margin="0,0,0,12">
                                    <StackPanel Margin="4">
                                        <TextBlock x:Name="CurrentDataSelectionText" Text="尚未选择数据；请从下方列表选择，或导入 CSV。" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#FF175CD3" />
                                        <ComboBox x:Name="SnapshotCombo" DisplayMemberPath="DisplayName" Height="42" Margin="0,8,0,0" ToolTip="列表按合约、中文周期、日期范围和根数显示；内部使用快照 ID。" />
                                        <Button x:Name="LoadSnapshotButton" Content="加载所选数据" Height="36" Margin="0,6,0,0" Click="LoadSnapshotButton_Click" ToolTip="把所选数据加载到当前研究上下文，并自动带入策略页。" Style="{StaticResource PrimaryButton}" />
                                        <Button x:Name="ImportButton" Content="导入本地 CSV" Height="34" Margin="0,6,0,0" Click="ImportButton_Click" ToolTip="导入本地行情 CSV，完成质量检查并生成可复用快照。" />
                                        <Button x:Name="CancelButton" Content="取消当前任务" Height="34" Margin="0,6,0,0" IsEnabled="False" Click="CancelButton_Click" ToolTip="取消正在进行的导入、查询或回放；已写入的只读记录会保留。" />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="02  下载新历史数据（可选）" Margin="0,0,0,12">
                                    <StackPanel Margin="4">
                                        <TextBlock Text="需要 TqSdk 账号；测试连接不会下单。" Foreground="#FF667085" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <TextBlock Text="具体合约（点击选择）" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <ComboBox x:Name="TqHistorySymbolCombo" DisplayMemberPath="DisplayName" Height="48" Margin="0,4,0,0" SelectionChanged="TqHistorySymbolCombo_SelectionChanged" DropDownClosed="TqHistorySymbolCombo_DropDownClosed" ToolTip="第一段是当前数据根已有的具体合约；后面是少量常用品种前缀入口。只有本地具体合约可以直接使用，前缀入口仍需补月份并经过连接和日历门禁。" />
                                        <TextBlock x:Name="TqHistorySymbolHintText" Text="本地具体合约优先；没有目标时可参考常用品种前缀，再展开手动输入完整月份合约。" Foreground="#FF667085" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        <Expander Header="手动输入其他具体合约（高级）" Margin="0,5,0,0">
                                            <StackPanel Margin="4">
                                                <TextBox x:Name="TqHistorySymbolText" Height="34" TextChanged="TqHistorySymbolText_TextChanged" ToolTip="填写具体合约代码；不能填主连、指数、888 或 999。" />
                                                <TextBlock Text="仅在列表没有目标合约时使用；请求仍会经过具体合约和日历门禁。" Foreground="#FF667085" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Expander>
                                        <TextBlock Text="周期" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <ComboBox x:Name="TqHistoryDurationCombo" Height="34" Margin="0,4,0,0" SelectedIndex="2" SelectionChanged="TqHistoryDurationCombo_SelectionChanged" ToolTip="面向用户的固定周期选项；内部仍使用秒数。">
                                            <ComboBoxItem Content="1分钟" Tag="60" />
                                            <ComboBoxItem Content="5分钟" Tag="300" />
                                            <ComboBoxItem Content="15分钟" Tag="900" />
                                            <ComboBoxItem Content="30分钟" Tag="1800" />
                                            <ComboBoxItem Content="60分钟" Tag="3600" />
                                            <ComboBoxItem Content="日线" Tag="86400" />
                                        </ComboBox>
                                        <TextBlock Text="行情路径" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <ComboBox x:Name="TqHistoryModeCombo" Height="34" Margin="0,4,0,0" SelectedIndex="0" ToolTip="普通路径适合有限历史；专业 DataDownloader 需要供应商权限。">
                                            <ComboBoxItem Content="普通 K 线（末端最多 8000 根）" Tag="standard" />
                                            <ComboBoxItem Content="专业 DataDownloader（需权限）" Tag="professional" />
                                        </ComboBox>
                                        <TextBlock Text="下载日期（北京时间，包含整天）" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <DatePicker x:Name="TqHistoryStartDatePicker" Height="34" Margin="0,0,3,0" SelectedDateChanged="TqHistoryDatePicker_SelectedDateChanged" ToolTip="开始日期：包含当天，从当天 00:00（北京时间）开始。" />
                                            <DatePicker x:Name="TqHistoryEndDatePicker" Grid.Column="1" Height="34" Margin="3,0,0,0" SelectedDateChanged="TqHistoryDatePicker_SelectedDateChanged" ToolTip="结束日期：包含当天，到次日 00:00（北京时间）结束。" />
                                        </Grid>
                                        <TextBlock Text="左侧开始日期、右侧结束日期；结束日期当天会完整包含。" Foreground="#FF667085" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        <Expander Header="高级：精确时间（可选，ISO 8601）" Margin="0,5,0,0">
                                            <StackPanel Margin="4">
                                                <TextBlock Text="同时填写下面两个时间后，将覆盖日期控件；留空则按整天下载。" Foreground="#FF667085" TextWrapping="Wrap" />
                                                <TextBox x:Name="TqHistoryStartText" Height="34" Margin="0,5,0,0" ToolTip="精确起点，ISO 8601；包含该时刻。建议带 +08:00。" />
                                                <TextBox x:Name="TqHistoryEndText" Height="34" Margin="0,5,0,0" ToolTip="精确终点，ISO 8601；不包含该时刻（左闭右开）。" />
                                            </StackPanel>
                                        </Expander>
                                        <Border Background="#FFFFF4E5" BorderBrush="#FFFDB022" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="历史下载前置检查" FontWeight="SemiBold" Foreground="#FF7A2E0B" />
                                                <TextBlock x:Name="TqHistoryCalendarStatusText" Text="正在检查本机研究日历……" TextWrapping="Wrap" Foreground="#FF7A2E0B" Margin="0,3,0,0" />
                                                <TextBlock Text="日线也不会因选择日期自动下载；先生成/检查适用日历，再明确点击“检查覆盖”或“下载并发布”。" TextWrapping="Wrap" Foreground="#FF7A2E0B" Margin="0,3,0,0" />
                                                <Button x:Name="GenerateLocalCalendarButton" Content="从当前已验证快照生成本机研究日历" Height="34" Margin="0,7,0,0" Click="GenerateLocalCalendarButton_Click" ToolTip="仅依据当前具体合约已有的、已验证的 15 分钟快照生成；不猜测节假日，不调用网络。" />
                                            </StackPanel>
                                        </Border>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="TqHistoryCheckButton" Content="检查覆盖" Height="34" Margin="0,0,3,0" Click="TqHistoryCheckButton_Click" ToolTip="只查询供应商实际可返回的行数、首末时间和完整性，不保存数据。" />
                                            <Button x:Name="TqHistoryDownloadButton" Content="下载并发布" Height="34" Grid.Column="1" Margin="3,0,0,0" Click="TqHistoryDownloadButton_Click" ToolTip="下载、质量检查并发布为本地快照，供后续策略回放使用。" Style="{StaticResource PrimaryButton}" />
                                        </Grid>
                                        <Button x:Name="TqHistoryCancelButton" Content="取消历史任务" Height="34" Margin="0,6,0,0" IsEnabled="False" Click="TqHistoryCancelButton_Click" ToolTip="停止历史覆盖检查或下载；不会删除已经发布的快照。" />
                                        <TextBlock x:Name="TqHistoryStatusText" Text="未启动历史任务" TextWrapping="Wrap" Foreground="#FF667085" Margin="0,6,0,0" />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="策略">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,8,0">
                            <StackPanel>
                                <TextBlock Text="当前数据已经选好后，在这里选策略、调整参数，再开始回测。" TextWrapping="Wrap" Foreground="#FF667085" Margin="0,0,0,12" />
                                <GroupBox Header="02  当前数据" Margin="0,0,0,12">
                                    <StackPanel Margin="4">
                                        <TextBlock x:Name="CurrentDataOnStrategyText" Text="尚未加载数据；请先到“数据”页选择 15/30/60 分钟数据。" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#FF175CD3" />
                                        <TextBlock Text="直接切换周期（当前合约）" Margin="0,8,0,0" FontWeight="SemiBold" />
                                        <ComboBox x:Name="StrategyPeriodCombo" DisplayMemberPath="PeriodDisplayName" Height="34" Margin="0,4,0,0" SelectionChanged="StrategyPeriodCombo_SelectionChanged" ToolTip="选择同一合约已有的 15/30/60 分钟快照后自动加载；下拉项按周期去重，使用最新快照。" />
                                        <Button x:Name="GoToDataButton" Content="去数据页切换合约/周期" Height="34" Margin="0,7,0,0" Click="GoToDataButton_Click" ToolTip="回到数据页选择已下载/已导入的快照，或下载新的周期。" />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="03  选择策略和参数" Margin="0,0,0,12">
                                    <StackPanel Margin="4">
                                        <TextBlock Text="策略卡片" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <ComboBox x:Name="StrategyPresetCombo" Height="36" Margin="0,4,0,0" SelectedIndex="0" SelectionChanged="StrategyPresetCombo_SelectionChanged" ToolTip="选择内置策略；白糖、铜、螺纹钢共用同一套策略入口。">
                                            <ComboBoxItem Content="SMA/EMA 均线交叉信号" Tag="sma_ema_cross.py" />
                                            <ComboBoxItem Content="SMA/EMA 均线交叉交易" Tag="sma_ema_cross_trade.py" />
                                            <ComboBoxItem Content="周期就绪信号（测试）" Tag="period_signal.py" />
                                        </ComboBox>
                                        <Border Background="#FFF5F9FF" BorderBrush="#FFD1E0FF" BorderThickness="1" CornerRadius="6" Margin="0,8,0,0" Padding="8">
                                            <StackPanel>
                                                <TextBlock x:Name="StrategyCardText" Text="快慢均线交叉时产生做多/做空信号；只做信号研究，不产生成交。" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                <TextBlock x:Name="StrategyCardMetaText" Text="类型：信号　结果：只看信号，不生成成交和盈亏" Foreground="#FF667085" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="LoadStrategyButton" Content="加载并校验所选策略" Height="34" Margin="0,8,0,0" Click="LoadStrategyButton_Click" ToolTip="读取策略名称、说明、kind、warmup 和参数；不会开始回测。" />
                                        <Button x:Name="ResetStrategyDefaultsButton" Content="恢复策略默认参数" Height="32" Margin="0,5,0,0" Click="ResetStrategyDefaultsButton_Click" ToolTip="新建或编辑回测时恢复策略声明的默认值；历史 run 仍保留原始参数。" />
                                        <TextBlock x:Name="StrategyDescriptorText" Text="未加载策略" TextWrapping="Wrap" Foreground="#FF667085" Margin="0,6,0,0" />
                                        <TextBlock Text="参数表单" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        <StackPanel x:Name="StrategyParameterFormPanel" Margin="0,4,0,0" />
                                        <TextBlock x:Name="StrategyParameterFormHint" Text="加载策略后显示参数默认值和范围。" Foreground="#FF667085" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="回测区间（通常已按当前数据自动填充）" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="时间显示为北京时间；一般不需要手动修改。" Foreground="#FF667085" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        <TextBox x:Name="StartInclusiveText" Text="" Height="34" Margin="0,4,0,0" ToolTip="回放起点（包含），例如 2026-10-01T09:00:00+08:00。" />
                                        <TextBox x:Name="EndExclusiveText" Text="" Height="34" Margin="0,4,0,0" ToolTip="回放终点（不包含），例如 2026-10-01T15:00:00+08:00。" />
                                        <Button x:Name="StartBacktestButton" Content="开始信号回放（无盈亏）" Height="42" Margin="0,10,0,0" Click="StartBacktestButton_Click" ToolTip="信号策略只回放信号；交易策略才会进入本地模拟成交和盈亏计算。" Style="{StaticResource PrimaryButton}" />
                                        <TextBlock x:Name="StrategyRunMeaningText" Text="信号策略：只产生信号，不产生成交、手续费或盈亏。" Foreground="#FF667085" Margin="0,5,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </GroupBox>
                                <Expander Header="高级设置：Python路径、原始JSON、严格/探索和分别回放" Margin="0,0,0,12">
                                    <StackPanel Margin="4">
                                        <TextBox x:Name="StrategyPathText" Text="strategies\sma_ema_cross.py" Height="34" Margin="0,6,0,0" TextChanged="StrategyPathText_TextChanged" ToolTip="本地 Python 策略路径；必须提供 STRATEGY、create_strategy 和 on_bar。" />
                                        <Button x:Name="ChooseStrategyButton" Content="选择本地策略文件" Height="34" Margin="0,6,0,0" Click="ChooseStrategyButton_Click" ToolTip="从本机选择可信的 Python 策略文件。" />
                                        <Button x:Name="CancelStrategyButton" Content="取消策略加载" Height="32" Margin="0,5,0,0" IsEnabled="False" Click="CancelStrategyButton_Click" ToolTip="取消正在进行的策略加载。" />
                                        <TextBlock Text="原始策略参数 JSON" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        <TextBox x:Name="StrategyParametersText" Text="{}" Height="88" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" FontFamily="Consolas" VerticalContentAlignment="Top" TextChanged="StrategyParametersText_TextChanged" ToolTip="高级参数入口；表单无法安全表达的参数在这里填写。" />
                                        <Button x:Name="ApplyAdvancedParametersButton" Content="应用高级 JSON 到参数表单" Height="32" Margin="0,5,0,0" Click="ApplyAdvancedParametersButton_Click" />
                                        <CheckBox x:Name="ExploreModeCheck" Margin="0,8,0,0" ToolTip="探索模式允许带质量缺口的数据继续运行；正式结果建议保持未勾选。">
                                            <TextBlock Text="探索模式（允许质量缺口）" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <Button x:Name="CheckConfigButton" Content="检查回放配置" Height="34" Margin="0,8,0,0" Click="CheckConfigButton_Click" ToolTip="检查快照、策略、参数、区间、warmup 和覆盖范围；不启动 Worker。" />
                                        <GroupBox Header="分别回放（高级）" Margin="0,8,0,0">
                                            <StackPanel Margin="4">
                                                <Button x:Name="ReplayButton" Content="开始信号回放" Height="34" Margin="0,4,0,0" Click="ReplayButton_Click" ToolTip="运行 signal 策略，只产生信号，不产生成交和收益。" />
                                                <Button x:Name="CancelReplayButton" Content="取消信号回放" Height="34" Margin="0,6,0,0" IsEnabled="False" Click="CancelReplayButton_Click" ToolTip="取消信号回放并保留适用的 partial 记录。" />
                                                <TextBlock Text="交易设置（交易策略）" FontWeight="SemiBold" Margin="0,10,0,0" />
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TradeLotsText" Text="1" Margin="0,0,3,0" ToolTip="模拟手数。" />
                                                    <TextBox x:Name="TradeOpenFeeText" Text="2" Grid.Column="1" Margin="3,0,0,0" ToolTip="每手开仓手续费。" />
                                                    <TextBox x:Name="TradeCloseFeeText" Text="1" Grid.Row="1" Margin="0,5,3,0" ToolTip="每手普通平仓手续费。" />
                                                    <TextBox x:Name="TradeSlippageText" Text="0" Grid.Column="1" Grid.Row="1" Margin="3,5,0,0" ToolTip="滑点跳数。" />
                                                </Grid>
                                                <Button x:Name="ApplyTradeFormButton" Content="应用交易设置" Height="32" Margin="0,6,0,0" Click="ApplyTradeFormButton_Click" ToolTip="把数量、费用和滑点表单转换为内部交易配置 JSON。" />
                                                <TextBox x:Name="TradeConfigText" Height="88" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" FontFamily="Consolas" VerticalContentAlignment="Top" ToolTip="高级交易配置 JSON：资金、乘数、最小跳动、保证金和费率等。" />
                                                <Button x:Name="TradeReplayButton" Content="开始交易回放" Height="34" Margin="0,8,0,0" Click="TradeReplayButton_Click" ToolTip="按下一根有效K线开盘价模拟成交，不下真实单。" />
                                                <Button x:Name="CancelTradeReplayButton" Content="取消交易回放" Height="34" Margin="0,6,0,0" IsEnabled="False" Click="CancelTradeReplayButton_Click" ToolTip="取消交易回放并保留已写入的适用记录。" />
                                                <Button x:Name="CopyTradeConfigButton" Content="复制当前交易配置到新 run" Height="34" Margin="0,6,0,0" Click="CopyTradeConfigButton_Click" ToolTip="复制当前参数到新的研究上下文；不会修改原 run。" />
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="记录">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,8,0">
                            <StackPanel>
                                <TextBlock Text="这里显示当前/最近 run 和常用导出；原始文件、手填 run ID 与筛选在高级设置中。" TextWrapping="Wrap" Foreground="#FF667085" Margin="0,0,0,8" />
                                <TextBlock x:Name="CurrentRunSummaryText" Text="当前为新研究配置" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#FF344054" Margin="0,0,0,8" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ExportTradeFillsButton" Content="导出成交" Margin="0,0,3,0" IsEnabled="False" Click="ExportTradeFillsButton_Click" ToolTip="导出当前交易 run 的成交明细 CSV。" />
                                    <Button x:Name="ExportTradeEquityButton" Content="导出权益" Grid.Column="1" Margin="3,0,0,0" IsEnabled="False" Click="ExportTradeEquityButton_Click" ToolTip="导出当前交易 run 的权益曲线 CSV。" />
                                </Grid>
                                <Button x:Name="ExportTradeSummaryButton" Content="导出交易摘要 JSON" Height="34" Margin="0,6,0,0" IsEnabled="False" Click="ExportTradeSummaryButton_Click" ToolTip="导出当前交易 run 的摘要、费用、权益和状态 JSON。" />
