                                            <TextBox x:Name="CategoryFilterText" Margin="0,0,3,0" ToolTip="按信号类别筛选，可留空。" />
                                            <TextBox x:Name="DirectionFilterText" Grid.Column="1" Margin="3,0,0,0" ToolTip="按方向筛选，例如 long、short，可留空。" />
