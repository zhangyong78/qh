                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                        <Button x:Name="TqSaveButton" Content="保存" Height="34" Margin="0,0,3,0" Click="TqSaveButton_Click" ToolTip="把账号信息保存到当前 Windows 用户保护存储；不是登录网站。" />
                                        <Button x:Name="TqTestButton" Content="测试连接" Height="34" Grid.Column="1" Margin="3,0,0,0" Click="TqTestButton_Click" ToolTip="测试 TqSdk 连接、依赖和权限；不会启动策略或下单。" />
                                        </Grid>
                                        <Button x:Name="TqCancelButton" Content="取消连接测试" Height="34" Margin="0,6,0,0" IsEnabled="False" Click="TqCancelButton_Click" ToolTip="停止当前连接测试。" />
                                        <Button x:Name="TqDeleteButton" Content="删除本机凭据" Height="34" Margin="0,6,0,0" Click="TqDeleteButton_Click" ToolTip="删除当前 Windows 用户保护存储中的账号凭据；不会删除行情或 run。" />
                                        <TextBlock x:Name="TqSdkStatusText" Text="默认离线；未连接" TextWrapping="Wrap" Foreground="#FF667085" Margin="0,6,0,0" />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="实时提醒（G5-A 本机基础）" Margin="0,0,0,12">
                                    <StackPanel Margin="6">
                                        <TextBlock Text="实例名称" TextWrapping="Wrap" />
                                        <TextBox x:Name="LiveInstanceIdText" Height="34" Margin="0,3,0,0" Text="sr2701-main" ToolTip="本机提醒实例名称；账本最多保留 5 个实例记录，当前实时桥接入口一次只运行一个会话。" />
                                        <TextBlock Text="具体合约" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <ComboBox x:Name="TqLiveSymbolCombo" DisplayMemberPath="DisplayName" Height="48" Margin="0,3,0,0" SelectionChanged="TqLiveSymbolCombo_SelectionChanged" DropDownClosed="TqLiveSymbolCombo_DropDownClosed" ToolTip="只列出当前数据根已发布的真实具体合约；选择后会沿用同一具体合约解析和日历门禁。" />
                                        <TextBlock x:Name="TqLiveSymbolHintText" Text="优先从本地已验证具体合约中选择；列表为空时可展开高级手动输入。" Foreground="#FF667085" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        <Expander Header="手动输入其他具体合约（高级）" Margin="0,4,0,0">
                                            <StackPanel Margin="4">
                                                <TextBox x:Name="TqLiveSymbolText" Height="34" TextChanged="TqLiveSymbolText_TextChanged" ToolTip="填写完整具体合约代码，例如 CZCE.SR701；不能填主连、指数、888 或 999。" />
                                                <TextBlock Text="手动输入仍会经过具体合约、账号和本机日历门禁。" Foreground="#FF667085" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Expander>
                                        <TextBlock Text="策略" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <TextBlock x:Name="LiveStrategySelectionText" Text="尚未加载并校验策略；请先到策略页选择。" Margin="0,3,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#FF175CD3" />
                                        <Button x:Name="GoToStrategyButton" Content="去策略页选择并校验" Height="32" Margin="0,4,0,0" Click="GoToStrategyButton_Click" ToolTip="回到策略页选择并加载校验策略；实时启动前必须有有效 descriptor。" />
                                        <ComboBox x:Name="TqLiveDurationCombo" Height="34" Margin="0,4,0,0" SelectedIndex="2" ToolTip="实时K线周期；显示中文周期，内部使用供应商秒数。">
                                            <ComboBoxItem Content="1分钟" Tag="60" />
                                            <ComboBoxItem Content="5分钟" Tag="300" />
                                            <ComboBoxItem Content="15分钟" Tag="900" />
                                            <ComboBoxItem Content="30分钟" Tag="1800" />
                                            <ComboBoxItem Content="60分钟" Tag="3600" />
                                            <ComboBoxItem Content="日线" Tag="86400" />
                                        </ComboBox>
                                        <TextBlock Text="通知渠道" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <TextBlock x:Name="LiveStrategyRuntimeText" Text="策略状态：未配置" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#FF667085" />
                                        <WrapPanel>
                                            <CheckBox x:Name="LiveDesktopCheck" Content="桌面通知" IsChecked="True" Margin="0,0,12,0" />
                                            <CheckBox x:Name="LiveSoundCheck" Content="声音" IsChecked="True" />
                                        </WrapPanel>
                                        <TextBlock Text="同类同方向冷却（秒，默认0）" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <TextBox x:Name="LiveCooldownText" Height="34" Margin="0,3,0,0" Text="0" ToolTip="仅抑制同一实例、同一信号类别、同一方向；反向信号不受影响。软件内信号仍会保留。" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="TqLiveStartButton" Content="启动提醒" Height="34" Margin="0,0,3,0" Click="TqLiveStartButton_Click" ToolTip="启动本机提醒实例；只消费完成K线，不下真实单。" />
                                            <Button x:Name="TqLiveStopButton" Content="停止实例" Height="34" Grid.Column="1" Margin="3,0,0,0" IsEnabled="False" Click="TqLiveStopButton_Click" ToolTip="停止实例计算并保留历史信号账本。" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="LivePauseButton" Content="暂停通知" Height="32" Margin="0,0,3,0" Click="LivePauseButton_Click" ToolTip="暂停通知但继续计算和记录信号。" />
                                            <Button x:Name="LiveSoundButton" Content="静音" Height="32" Grid.Column="1" Margin="3,0,0,0" Click="LiveSoundButton_Click" ToolTip="只关闭声音，软件内信号和桌面通知不受影响。" />
                                        </Grid>
                                        <Button x:Name="LiveTestNotificationButton" Content="测试通知（不写入信号账本）" Height="32" Margin="0,6,0,0" Click="LiveTestNotificationButton_Click" ToolTip="显示测试提醒并播放测试声音；不会写入真实信号账本。" />
                                        <TextBox x:Name="LiveReminderListText" Height="105" Margin="0,6,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="实例状态：合约、中文周期、策略、最近完成K线、最近计算和最近信号。" />
                                        <TextBlock Text="软件内信号列表（始终保留）" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <TextBox x:Name="LiveSignalHistoryText" Height="145" Margin="0,3,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="按完成K线时间倒序显示已写入账本的信号及各通知渠道状态。" />
                                        <TextBlock Text="完成K线策略求值尚未接入；当前仅账本/测试通知基础，不会产生实际策略提醒。" TextWrapping="Wrap" Foreground="#FF9A3412" Margin="0,6,0,0" />
                                        <TextBlock x:Name="TqLiveStatusText" Text="未启动实时会话" TextWrapping="Wrap" Foreground="#FF667085" Margin="0,6,0,0" />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="后台 Worker" Margin="0,0,0,12">
                                    <StackPanel Margin="4">
                                        <Button x:Name="StartWorkerButton" Content="启动 Worker" Height="34" Margin="0,10,0,0" Click="StartWorkerButton_Click" ToolTip="启动受管理的本地 Python Worker；通常由回放按钮自动控制。" />
                                        <Button x:Name="CancelWorkerButton" Content="取消 Worker 任务" Height="34" Margin="0,8,0,0" IsEnabled="False" Click="CancelWorkerButton_Click" ToolTip="向 Worker 发送取消命令并等待 cancelled 确认。" />
                                        <Button x:Name="StopWorkerButton" Content="停止 Worker" Height="34" Margin="0,8,0,0" IsEnabled="False" Click="StopWorkerButton_Click" ToolTip="停止 Worker 并等待 stopped；仅在需要人工收尾时使用。" />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#FFE4E7EC" ToolTip="拖动调整操作区宽度" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="160" />
                    <RowDefinition x:Name="ResultsSplitterRow" Height="6" />
                    <RowDefinition x:Name="ResultsRow" Height="2*" MinHeight="160" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="70" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="4,2,4,4">
                            <TextBlock x:Name="ChartTitleText" Text="尚无数据" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="ChartRangeText" Text="" Foreground="#FF667085" TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Margin="4,0,4,5">
                            <Button Content="＋" Click="ChartZoomIn_Click" Padding="9,2" ToolTip="放大" />
                            <Button Content="－" Click="ChartZoomOut_Click" Padding="9,2" Margin="4,0" ToolTip="缩小" />
                            <Button Content="最近240根" Click="ChartReset_Click" Padding="6,2" />
                            <Button Content="全量" Click="ChartAll_Click" Padding="6,2" Margin="4,0" />
                            <Button x:Name="ChartFocusButton" Content="展开图表" Click="ChartFocus_Click" Padding="6,2" />
                            <TextBlock x:Name="AverageLegendText" Foreground="#FF667085" Margin="10,3,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="滚轮缩放 · 拖动平移 · 悬停检查 · 点击成交定位" Foreground="#FF667085" Margin="10,3,0,0" TextWrapping="Wrap" />
                        </WrapPanel>
                        <Canvas x:Name="ChartCanvas" Grid.Row="2" Background="White" ClipToBounds="True" SizeChanged="ChartCanvas_SizeChanged" MouseMove="ChartCanvas_MouseMove" MouseWheel="ChartCanvas_MouseWheel" MouseLeave="ChartCanvas_MouseLeave" MouseLeftButtonDown="ChartCanvas_MouseLeftButtonDown" MouseLeftButtonUp="ChartCanvas_MouseLeftButtonUp" />
                        <Canvas x:Name="EquityCanvas" Grid.Row="3" Background="#FFF8FAFC" ClipToBounds="True" SizeChanged="EquityCanvas_SizeChanged" />
                    </Grid>
                </Border>
                <GridSplitter x:Name="ResultsSplitter" Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows" Background="#FFE4E7EC" />
                <Grid x:Name="ResultsPanel" Grid.Row="2" Margin="0,6,0,0">
                    <TabControl x:Name="ResultTabs">
                        <TabItem Header="回测概览">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Text="快速看懂本次回测的对象、核心收益和风险；详细流水与诊断在后面的页签。" Foreground="#FF667085" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock x:Name="OverviewText" Text="尚无回测结果；完成回测或打开历史 run 后，这里会显示摘要。" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Foreground="#FF344054" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button x:Name="OverviewEditStrategyButton" Content="修改策略" Margin="0,0,6,6" Click="OverviewEditStrategyButton_Click" />
                                        <Button x:Name="OverviewReloadDataButton" Content="重新选择数据" Margin="0,0,6,6" Click="OverviewReloadDataButton_Click" />
                                        <Button x:Name="OverviewRerunButton" Content="按当前配置再次回测" Margin="0,0,6,6" IsEnabled="False" Click="OverviewRerunButton_Click" />
                                        <Button x:Name="OverviewExportButton" Content="导出结果" Margin="0,0,6,6" IsEnabled="False" Click="OverviewExportButton_Click" />
                                    </WrapPanel>
                                    <TextBlock Text="高级摘要" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    <TextBlock x:Name="TradeResultText" Text="尚无交易回放结果" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#FF344054" />
                                    <TextBox x:Name="ReportDetailsText" Margin="0,10,0,0" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" Background="Transparent" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="成交流水">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="查看每笔模拟成交、方向、价格、手续费和滑点；点击行可定位图表。" Foreground="#FF667085" Margin="10,8,10,6" TextWrapping="Wrap" />
                            <DataGrid x:Name="TradeFillGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="TradeFillGrid_SelectionChanged" HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" AlternatingRowBackground="#FFF8FAFC">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="序号" Binding="{Binding FillSequence}" MinWidth="65" />
                                    <DataGridTextColumn Header="K线结束时间" Binding="{Binding BarEnd, StringFormat=yyyy-MM-dd HH:mm}" MinWidth="65" />
                                    <DataGridTextColumn Header="动作" Binding="{Binding Action}" MinWidth="65" />
                                    <DataGridTextColumn Header="方向" Binding="{Binding Direction}" MinWidth="65" />
                                    <DataGridTextColumn Header="手数" Binding="{Binding Quantity}" MinWidth="65" />
                                    <DataGridTextColumn Header="成交价" Binding="{Binding Price, StringFormat=0.##}" MinWidth="65" />
                                    <DataGridTextColumn Header="手续费" Binding="{Binding Fee, StringFormat=0.##}" MinWidth="65" />
                                    <DataGridTextColumn Header="滑点" Binding="{Binding Slippage}" MinWidth="65" />
                                </DataGrid.Columns>
                            </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="已平仓交易">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="查看已完成交易的入场、离场、毛利、费用和净利。" Foreground="#FF667085" Margin="10,8,10,6" TextWrapping="Wrap" />
                            <DataGrid x:Name="ClosedTradeGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="ClosedTradeGrid_SelectionChanged" HeadersVisibility="Column" BorderThickness="0" CanUserAddRows="False" EnableRowVirtualization="True" AlternatingRowBackground="#FFF8FAFC">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="方向" Binding="{Binding Direction}" MinWidth="65" />
                                    <DataGridTextColumn Header="入场K线结束" Binding="{Binding EntryTime, StringFormat=yyyy-MM-dd HH:mm}" MinWidth="65" />
                                    <DataGridTextColumn Header="离场K线结束" Binding="{Binding ExitTime, StringFormat=yyyy-MM-dd HH:mm}" MinWidth="65" />
                                    <DataGridTextColumn Header="手数" Binding="{Binding Quantity}" MinWidth="65" />
                                    <DataGridTextColumn Header="入场价" Binding="{Binding EntryPrice, StringFormat=0.##}" MinWidth="65" />
                                    <DataGridTextColumn Header="离场价" Binding="{Binding ExitPrice, StringFormat=0.##}" MinWidth="65" />
                                    <DataGridTextColumn Header="毛利" Binding="{Binding GrossPnl, StringFormat=0.##}" MinWidth="65" />
                                    <DataGridTextColumn Header="费用" Binding="{Binding Fees, StringFormat=0.##}" MinWidth="65" />
                                    <DataGridTextColumn Header="净利" Binding="{Binding NetPnl, StringFormat=0.##}" MinWidth="65" />
                                </DataGrid.Columns>
                            </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="策略信号">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="查看策略在何时给出信号；信号不是成交，点击行可定位K线。" Foreground="#FF667085" Margin="10,8,10,6" TextWrapping="Wrap" />
                            <DataGrid x:Name="SignalGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="SignalGrid_SelectionChanged" HeadersVisibility="Column" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="K线结束时间" Binding="{Binding BarEnd, StringFormat=yyyy-MM-dd HH:mm}" MinWidth="65" />
                                    <DataGridTextColumn Header="类别" Binding="{Binding Category}" MinWidth="65" />
                                    <DataGridTextColumn Header="方向" Binding="{Binding Direction}" MinWidth="65" />
                                    <DataGridTextColumn Header="价格" Binding="{Binding ReferencePrice}" MinWidth="65" />
                                    <DataGridTextColumn Header="说明" Binding="{Binding Description}" MinWidth="65" />
                                </DataGrid.Columns>
                            </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="数据质量">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="查看缺口、重复、乱序、未完成K线和数据覆盖范围；严格回放会使用这里的门禁。" Foreground="#FF667085" Margin="10,8,10,6" TextWrapping="Wrap" />
                                <TextBox x:Name="QualityText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="8" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="高级诊断 / 运行日志">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="查看任务进度、Worker 状态和故障诊断；通常不需要日常操作。" Foreground="#FF667085" Margin="10,8,10,6" TextWrapping="Wrap" />
                                <TextBox x:Name="LogText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="8" />
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
